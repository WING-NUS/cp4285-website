{
  "name": "cp4285-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "CP4285 Modern Recommendation Systems documentation website built with Hugo Blox",
  "scripts": {
    "dev": "node scripts/hugo-with-tailwind.mjs server --disableFastRender",
    "build": "node scripts/hugo-with-tailwind.mjs --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
